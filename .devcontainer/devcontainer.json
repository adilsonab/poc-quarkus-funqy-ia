{
  "name": "poc-quarkus-funqy-ia",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "runServices": ["workspace", "database"],
  "shutdownAction": "stopCompose",
  "forwardPorts": [8080, 5432],
  "portsAttributes": {
    "8080": {
      "label": "Quarkus Funqy HTTP"
    },
    "5432": {
      "label": "PostgreSQL"
    }
  },
  "postCreateCommand": "./mvnw -B -DskipTests package"
}
